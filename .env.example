# 复制成 .env 再填：cp .env.example .env
#
# 注意：= 后面不要留空格，否则 run.sh 里的 source .env 会报错。
# .env 在 .gitignore 里，不会被提交 —— 换电脑时要手动拷过去。

# ---- Zectrix（必填）----
# 在 https://cloud.zectrix.com/ 拿
API_KEY=
DEVICE_ID=

# ---- 同步范围 ----
# 0 = 只同步今天。工作日历事件多的话别开太大，墨水屏会刷满。
SYNC_DAYS_BACK=0
SYNC_DAYS_AHEAD=0

# ---- Apple 提醒事项 ----
# 留空 = 所有列表。名字用 ./run.sh --list-calendars 查
# APPLE_LISTS=个人,工作
# APPLE_LIST=提醒事项

# ---- 日历事件（单向推到墨水屏）----
# both=EventKit+CalDAV 都读并去重 / eventkit=只读 macOS 日历 / caldav / none
CALENDAR_SOURCE=both
# 留空 = 所有日历。Google / umd.edu 这类工作日历：先在
# 「系统设置 → 互联网账户」加账号，再用 --list-calendars 查名字填这里
# CALENDAR_LISTS=Calendar,UMD

# CalDAV 来源（iCloud 这类还支持密码登录的才填；Google 已经不支持了）
# CALDAV_URL=https://caldav.icloud.com/
# CALDAV_USER=
# CALDAV_PASS=

# [日历] 日程过期多久（小时）后自动划掉
EXPIRE_HOURS=1

# ---- 删除策略 ----
# apple-master = 提醒事项删了墨水屏跟着删，墨水屏删了保留提醒事项
# mirror = 两边都跟着删    none = 都不删
DELETE_POLICY=apple-master
